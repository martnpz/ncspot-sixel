# direnv
/.direnv/

# Generated by Cargo
# will have compiled files and executables
/target/
/.idea/

# These are backup files generated by rustfmt
**/*.rs.bk

*.log

tags

# Ignore generated resources
*.1
# This versioned source directory is required by Cargo's local patch.
!/vendor/cursive-0.21.1/
/vendor/cursive-0.21.1/.cargo-ok
/misc/_ncspot
/misc/ncspot.bash
/misc/ncspot.fish
/misc/ncspot.elv
/misc/_ncspot.ps1

# Local configuration, credentials and runtime caches
/config.toml
/config.toml.*
!/config.toml.example
.env
.env.*
!.env.example
rspotify_token*.json
credentials.json
userstate.cbor
/librespot/
/cache/
/covers/
/*.db

# Private keys and credential bundles
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
