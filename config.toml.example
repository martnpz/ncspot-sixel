# Example configuration for ncspot-sixel.
# Copy to ~/.config/ncspot/config.toml and adjust to taste.
# All keys are optional; the values shown here are the defaults unless noted.
# Full reference: doc/users.md

# Nerd Font glyphs for playback/repeat/shuffle/saved indicators.
use_nerdfont = true

# Show the icon of the action play/pause would trigger instead of the
# current playback state.
flip_status_indicators = false

# Screen shown after startup: "panes" (multi-pane layout, default),
# "library", "search", "queue", "lyrics" or "cover".
initial_screen = "panes"

bitrate = 320
gapless = true

###############################################################################
# Audio (native PipeWire sink)
###############################################################################

# Audio backend. The native PipeWire sink is the default when unset.
# Set to "pulseaudio" to use the librespot PulseAudio backend instead.
#backend = "pipewire"

# Optional PipeWire target node (maps to target.object), e.g. a node.name
# from `pw-cli ls Node`. Unset = let PipeWire/WirePlumber route.
#backend_device = "alsa_output.pci-0000_00_1f.3.analog-stereo"

# Requested PipeWire quantum in frames at 44.1 kHz. This is the output
# latency: 1024 ≈ 23 ms (default), 512 ≈ 12 ms, 256 ≈ 6 ms.
# Lower values reduce latency at the cost of more frequent wakeups.
pipewire_quantum = 1024

###############################################################################
# Cover art
###############################################################################

# Covers are rendered in-process with sixel (requires a sixel-capable
# terminal; support is detected via the terminal's DA1 reply at startup).
# The legacy `cover_backend` key is accepted but ignored.

# Maximum scaling ratio for cover art (useful on HiDPI displays).
#cover_max_scale = 1.0

###############################################################################
# Pane layout (the "panes" screen)
###############################################################################
# Columns are listed left to right with a width in percent (must sum to at
# most 100); each column stacks one or more panes vertically. Valid pane
# names: browser, tracks, info, cover, lyrics, playlists, queue.
#
# - browser: section browser; its title is a dropdown (click it or press
#   Shift+O) switching between Search / Playlists / Albums / Artists /
#   Recommendations. Open the selected item with "o".
# - tracks:  target pane where playlists/albums/etc. open as a track list
#   with album-art thumbnails; navigation stacks here, Backspace goes back.
# - info:    cover of the playing track + title / artist / genres.
# - cover:   image-only cover pane; playlists: plain playlist list.
#
# Move focus with Tab (next pane) or Alt+h/j/k/l, or rebind the
# "focuspane left|right|up|down|next" command.
#
# The layout below is the built-in default.

# Empty cells between the screen edge and between adjacent pane islands.
# 0 = no gap (panes touch), 1 = default, 2+ = wider gutters.
#gap = 1

# Extra padding inside each island border on all sides (border is always 1 cell).
# 0 = content touches the border (default), 1+ = breathing room inside.
#padding = 0

[[layout.columns]]
width = 50
panes = ["browser"]

[[layout.columns]]
width = 50
panes = ["info", "lyrics"]
# Per-pane height as % of column height; last pane gets the remainder.
# Must have the same number of entries as `panes`. Omit for even split.
heights = [30, 70]

[layout.browser]
# Dropdown sections, in order.
sections = ["search", "playlists", "albums", "artists", "recommendations"]
# Section shown at startup.
default_section = "playlists"
# "default" keeps Spotify's natural order; "name" sorts alphabetically
# (snapshot at startup).
sort = "default"
# Cover-art thumbnails for playlists and albums. Row height in cells;
# 1 disables thumbnails. Requires a sixel-capable terminal.
row_height = 2
thumbnails = true

[layout.tracks]
# Track row height in cells; 1 disables thumbnails.
row_height = 2
# Album-art thumbnails next to each track (requires a sixel terminal).
thumbnails = true
# Persistent filter input at the top of the track list (activate with /).
filter_row = true
# Default sort order when opening a playlist or album.
# A manual "sort" command overrides this and is remembered per playlist.
# Values: "last_added", "first_added", "duration", "alphabetical", "reverse"
#default_sort = "last_added"

[layout.info]
# Number of artist genres shown below the cover. Note: Spotify has
# deprecated artist genres, so this may be empty for some artists.
genres = 2

###############################################################################
# Player bar (always island style: ╭── title ──╮ / │ bar │ / │ controls │ / ╰──╯)
###############################################################################
# [statusbar]
# # Rows for the progress bar. 1 = one thin line (default), 2-3 = taller bar.
# height = 1
# # Progress bar character style:
# #   "square"  — █/░ (default)
# #   "thin"    — ━/┉
# #   "rounded" — █/░ with nerd-font half-circle end caps
# style = "square"
# # End caps for the "rounded" style (nerd font glyphs).
# progress_cap_left  = ""   # nf-ple-left_half_circle_thick
# progress_cap_right = ""   # nf-ple-right_half_circle_thick
# # Controls row button style:
# #   "square"  — bracket delimiters below (default)
# #   "rounded" — nerd-font half-circle pill around each icon
# controls_style = "square"
# # Delimiters wrapped around each button ("square" style).
# button_open  = "[ "
# button_close = " ]"
# # Pill caps for the "rounded" controls style (nerd font glyphs).
# controls_cap_left  = ""   # nf-ple-left_half_circle_thick
# controls_cap_right = ""   # nf-ple-right_half_circle_thick
# # Tag prepended to the track title when the track is a Spotify recommendation
# # (smart shuffle or "Similar to …" list). Set to "" to disable.
# suggested_tag = "[N] "
# # Animate a bright left-to-right shimmer over a recommended track's title.
# suggested_shimmer = true

###############################################################################
# Lyrics
###############################################################################
# The currently sung line is kept vertically centered (the text scrolls up
# past the end) and marked with an icon in the left gutter; upcoming lines
# are dimmed. Scroll with the mouse wheel or movement keys to detach from
# playback; press Back (Backspace) or use the "move playing" command to
# re-attach.

[lyrics]
# Horizontal text position: "left", "center" or "right".
align = "center"

###############################################################################
# Icons
###############################################################################
# Override individual icons. Unset icons fall back to Nerd Font defaults
# when use_nerdfont is enabled, ASCII defaults otherwise.

#[icons]
#playing = "▶ "
#paused = "▮▮"
#stopped = "◼ "
#repeat = "R"           # repeat playlist
#repeat_track = "R"     # repeat one track
#repeat_off = "X"       # no repeat
#shuffle = "S"          # shuffle on
#smart_shuffle = "S~"   # smart shuffle (visual only, same playback as shuffle)
#shuffle_off = "X"      # shuffle off
#player_prev = "|<"     # skip-previous button in the player bar
#player_next = ">|"     # skip-next button in the player bar
#saved = "♥"
#updating = "[U] "
#lyrics_current = "♪ "
#filter = "> "         # icon shown in the track-list filter input row
#pane_back = " "    # prefix shown in pane title when the view stack has depth > 1
#pane_menu = " "    # suffix shown in pane title when the view has a dropdown action
# Drop-menu item icons (prefix before the label in every dropdown).
#menu_search = "/ "
#menu_playlists = "= "
#menu_albums = "♫ "
#menu_artists = "@ "
#menu_recommendations = "* "
#menu_lyrics = "♪ "
#menu_queue = "= "
#menu_add_to_queue = "> "
#menu_add_to_playlist = "+ "
#menu_remove_from_playlist = "- "
#menu_remove_recommendation = "✗ "  # "Remove recommendation" (recommended songs only)
#menu_share = "↗ "

###############################################################################
# Theme colors
###############################################################################
# All color values accept:
#   - Hex:   "#rrggbb"
#   - Named: "dark red", "light blue", "default", etc.
#   - Palette reference (inherits from the main palette):
#     Background, Shadow, View, Primary, Secondary, Tertiary,
#     TitlePrimary, TitleSecondary, Highlight, HighlightInactive, HighlightText

#[theme]
## Standard palette
#background           = "default"
#primary              = "default"
#secondary            = "dark blue"
#title                = "dark red"
#highlight            = "dark white"    # text on highlighted row
#highlight_bg         = "dark red"      # background of highlighted row
#highlight_inactive_bg = "dark blue"    # background of inactive rows
#playing              = "dark blue"
#playing_selected     = "light blue"
#playing_bg           = "default"
#error                = "default"
#error_bg             = "dark red"
#statusbar_progress   = "dark blue"
#statusbar_progress_bg = "light black"
#statusbar            = "dark yellow"
#statusbar_bg         = "default"
#statusbar_controls   = "dark yellow"   # controls row fg; defaults to statusbar
#statusbar_controls_bg = "default"      # controls row bg; defaults to statusbar_bg
#statusbar_controls_active    = "white"      # enabled shuffle/repeat + press blink
#statusbar_controls_button_bg = "light black" # pill bg for the "rounded" controls style
#cmdline              = "default"
#cmdline_bg           = "default"
#search_match         = "light red"

## Drop-menu colors (section-switcher dropdown and Now Playing options).
## Defaults inherit from the main palette entries shown on the right.
#dropdown_fg          = "Primary"           # text color of unfocused rows
#dropdown_bg          = "HighlightInactive" # background of unfocused rows
#dropdown_focused_fg  = "HighlightText"     # text color of the focused row
#dropdown_focused_bg  = "Highlight"         # background of the focused row
#dropdown_border      = "TitleSecondary"    # border color of the rounded box

###############################################################################
# Keybindings
###############################################################################
# Map a key to a command string (run several with ";"). Modifiers: Shift+,
# Ctrl+, Alt+. Named keys: Enter, Space, Tab, Backspace, Esc, Left, Right, Up,
# Down, Ins, Del, Home, End, PageUp, PageDown, F1-F12.
#
# Set `default_keybindings = false` (top of file) to start from an empty map.
# Any binding you add under [keybindings] overrides the matching default below.
#
# The full list of built-in defaults follows (all commented out). Uncomment and
# change the key to rebind, e.g. give "next" to "Ctrl+Right".

#[keybindings]

## Playback
#"Shift+p"  = "playpause"
#"Shift+s"  = "stop"
#"<"        = "previous"
#">"        = "next"
#"f"        = "seek +1000"     # forward 1s
#"b"        = "seek -1000"     # back 1s
#"Shift+f"  = "seek +10000"    # forward 10s
#"Shift+b"  = "seek -10000"    # back 10s
#"+"        = "volup 1"
#"]"        = "volup 5"
#"-"        = "voldown 1"
#"["        = "voldown 5"
#"r"        = "repeat"         # cycle repeat mode
#"z"        = "shuffle"        # toggle shuffle

## Queue / track actions
#"Enter"    = "play"
#"Space"    = "queue ; move down"
#"."        = "playnext ; move down"
#"c"        = "clear"
#"s"        = "save"
#"Ctrl+s"   = "save queue"
#"d"        = "delete"
#"x"        = "share selected"     # requires share_clipboard feature
#"Shift+x"  = "share current"      # requires share_clipboard feature
#"Ctrl+v"   = "insert"             # insert URL from clipboard (share_clipboard)

## Navigation / views
#"o"        = "open selected"
#"Shift+o"  = "open current"
#"a"        = "goto album"
#"Shift+a"  = "goto artist"
#"m"        = "similar selected"   # recommendations for selected
#"Shift+m"  = "similar current"    # recommendations for playing
#"n"        = "jumpnext"           # next search match
#"Shift+n"  = "jumpprevious"       # previous search match
#"Backspace" = "back"
#"?"        = "help"

## Focus screens / panes
#"F1"       = "focus queue"
#"F2"       = "focus search"
#"F3"       = "focus library"
#"F4"       = "focus panes"
#"F8"       = "focus cover"        # requires cover feature
#"F9"       = "focus lyrics"
#"Tab"      = "focuspane next"
#"Alt+h"    = "focuspane left"
#"Alt+j"    = "focuspane down"
#"Alt+k"    = "focuspane up"
#"Alt+l"    = "focuspane right"

## Cursor movement (lists)
#"Up"       = "move up"
#"Down"     = "move down"
#"Left"     = "move left"
#"Right"    = "move right"
#"k"        = "move up"
#"j"        = "move down"
#"h"        = "move left"
#"l"        = "move right"
#"Ctrl+p"   = "move up"
#"Ctrl+n"   = "move down"
#"Ctrl+a"   = "move left"
#"Ctrl+e"   = "move right"
#"PageUp"   = "move up 5"
#"PageDown" = "move down 5"
#"Home"     = "move top"
#"End"      = "move bottom"
#"g"        = "move top"
#"Shift+g"  = "move bottom"
#"p"        = "move playing"       # jump cursor to playing track
#"Shift+Up"   = "shift up"         # reorder selected queue item up
#"Shift+Down" = "shift down"       # reorder selected queue item down

## App
#"q"        = "quit"
#"Shift+u"  = "update"             # refresh library from Spotify
#"Ctrl+l"   = "redraw"
